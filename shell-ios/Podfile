# =====================================================================
# 福优智家 iOS 原生壳 —— 第三方 SDK 依赖（可选集成）
# =====================================================================
# 说明：本壳在「无 Pods」状态下即可编译运行核心能力
#   （WebView / HTTP / 蓝牙 / 扫码 / 相册 / 权限 / 更新 / 内购 StoreKit）。
#
# 需要点亮以下能力时，在 Mac 上执行：
#   pod install
#   open CloudGuard.xcworkspace     # 注意此后打开 .xcworkspace 而非 .xcodeproj
#
# 微信 OpenSDK / 支付宝 SDK 一旦链接，AppSDK.swift 中的
#   #if canImport(WechatOpenSDK) / #if canImport(AlipaySDK)
# 分支即自动生效，无需改动任何桥接代码。
#
# 广告（Taku / AnyThinkiOS）：AdBridge/AdManager 已实现完整方法/事件契约与 VIP 免广告逻辑，
#   底层经 AdNetwork 抽象；TakuNetwork.swift 已提供真实实现，本文件开启下方 pod 后
#   AdNetworkFactory 编译期自动切换（#if canImport(AnyThinkSDK)）到 TakuNetwork。
#   注：集成 Pods 后本地需打开 CloudGuard.xcworkspace；CI 已配 pod install + -workspace。
# =====================================================================

platform :ios, '13.0'
use_frameworks!

target 'CloudGuard' do
  # —— 微信开放平台 SDK（支付 / 分享 / 小程序）——
  # 【必须 ≥2.0.5】2.0.4 的 xcframework 是裸 libWechatOpenSDK.a 且无 module map，
  # Swift `canImport(WechatOpenSDK)` 恒为 false → AppSDK 全部微信代码被条件编译剔除，
  # 表现为「拉起小程序/登录/支付静默失败」（TF 130 实锤，run 42 链接行无 -framework WechatOpenSDK）。
  # 2.0.5 起官方改为标准 WechatOpenSDK.framework（含 Modules），import 才生效。
  pod 'WechatOpenSDK-XCFramework', '2.0.5'

  # —— 支付宝 SDK：已移除 ——本 App 无真实支付宝支付（收银台支付宝选项为演示 UI，
  # 未调用 pay.alipay 桥）；且 AlipaySDK 需额外链接 SystemConfiguration/CoreTelephony/libz
  # 否则 Ld 阶段 Undefined symbols（CI run 12 实锤）。如未来启用支付宝支付再恢复下行。
  # pod 'AlipaySDK-iOS'

  # —— 广告聚合 Taku（AnyThinkiOS）+ 莱特摩比（Litemize）适配器 ——
  # 主包 6.5.84：Taku SDK 下载中心官方生成代码指定版本（2026-10-28）。
  # 【ATT 合规】iOS 广告已恢复启用（App.vue 初始化短路删除），授权弹窗由
  # TakuNetwork.initSDK 在 ATAPI.start 之前拉起（Guideline 2.1，2026-11-18 审核要求）；
  # ASC「App 隐私」需声明「用于追踪的数据」（IDFA/广告标识）。
  pod 'AnyThinkiOS', '6.5.84'                                    # Taku 聚合 SDK 主包
  # —— 酷盈（Taku ADX）适配器：保持移除 ——
  # 集成它会触发主包「集成完整性自检」误报 "AnyThink Adx SDK is missing" 启动弹窗
  # （缺的组件 CocoaPods 上不存在，文案服务端下发，后台关 ADX 也无效），审核 2.1(a) 被拒。
  # 现方案：不集成 ADX + AppDelegate 启动即 ignoreToastIfNeeded 双保险；待 Taku 官方
  # 给出正确组件版本后再恢复下列两行。
  # pod 'SmartdigimktCNSDK', '6.5.90'                              # 酷盈（Taku ADX）主 SDK
  # pod 'AnyThinkMediationAdxSmartdigimktCNAdapter', '6.5.90.2.1'  # 酷盈 Adx 适配器
  pod 'LitemobAd', '1.5.9'                                        # 莱特摩比 SDK 主包
  pod 'LitemobTakuAdapter', '1.1.3'                              # 莱特摩比 Taku 适配器
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
