# =====================================================================
# 福优智家 iOS 原生壳 —— 第三方 SDK 依赖（可选集成）
# =====================================================================
# 说明：本壳在「无 Pods」状态下即可编译运行核心能力
#   （WebView / HTTP / 蓝牙 / 扫码 / 相册 / 权限 / 更新 / 内购 StoreKit）。
#
# 需要点亮以下能力时，在 Mac 上执行：
#   pod install
#   open CloudGuard.xcworkspace     # 注意此后打开 .xcworkspace 而非 .xcodeproj
#
# 微信 OpenSDK / 支付宝 SDK 一旦链接，AppSDK.swift 中的
#   #if canImport(WechatOpenSDK) / #if canImport(AlipaySDK)
# 分支即自动生效，无需改动任何桥接代码。
#
# 广告（Taku / AnyThinkiOS）：AdBridge/AdManager 已实现完整方法/事件契约与 VIP 免广告逻辑，
#   底层经 AdNetwork 抽象；TakuNetwork.swift 已提供真实实现，本文件开启下方 pod 后
#   AdNetworkFactory 编译期自动切换（#if canImport(AnyThinkSDK)）到 TakuNetwork。
#   注：集成 Pods 后本地需打开 CloudGuard.xcworkspace；CI 已配 pod install + -workspace。
# =====================================================================

platform :ios, '13.0'
use_frameworks!

target 'CloudGuard' do
  # —— 微信开放平台 SDK（支付 / 分享 / 小程序）——
  pod 'WechatOpenSDK-XCFramework', '2.0.4'

  # —— 支付宝 SDK（App 支付）——
  pod 'AlipaySDK-iOS'

  # —— 广告聚合 Taku（AnyThinkiOS）+ 莱特摩比（Litemize）适配器，版本与云卫家实测一致 ——
  pod 'AnyThinkiOS', '6.5.73'                                    # Taku 聚合 SDK 主包
  pod 'AnyThinkMediationAdxSmartdigimktCNAdapter', '6.5.78.2.0'  # 酷映 Adx SDK（necessary）
  pod 'LitemobAd', '1.5.9'                                        # 莱特摩比 SDK 主包
  pod 'LitemobTakuAdapter', '1.1.3'                              # 莱特摩比 Taku 适配器
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
