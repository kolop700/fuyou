<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 出口合规：仅使用 Apple 系统标准 TLS（HTTPS），属豁免加密，声明后 TestFlight 上传不再弹「App 加密文稿」问卷 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>福优智家</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.16</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- 微信回调 URL Scheme：wx + 开放平台移动应用 AppId -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>weixin</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>wx8ea71b7e50187f1d</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>alipay</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ap.yefiot.fuyou</string>
            </array>
        </dict>
    </array>

    <!-- 白名单：检测/跳转 微信、支付宝 -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>weixin</string>
        <string>weixinULAPI</string>
        <string>wechat</string>
        <string>alipay</string>
        <string>alipaytransfer</string>
    </array>

    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- 蓝牙后台（连接门禁保持） -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>
    <key>UIFileSharingEnabled</key>
    <false/>

    <!-- ==================== 隐私描述（对齐 manifest.json） ==================== -->
    <key>NSCameraUsageDescription</key>
    <string>需要使用相机进行扫描门禁二维码、拍摄头像和人脸认证，以便您能使用开门和身份验证功能</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>需要访问相册以选择头像照片、保存分享的二维码图片，以及上传人脸认证照片</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>需要保存二维码及分享图片到您的相册</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>需要使用麦克风功能</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>需要使用蓝牙功能进行设备连接和开门</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>需要使用蓝牙功能进行设备连接和开门</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>需要使用位置服务以便更好地连接蓝牙设备</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>需要访问网络来进行通讯</string>

    <!-- App Transport Security：允许业务后端明文（对齐 Android usesCleartextTraffic） -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
</dict>
</plist>
