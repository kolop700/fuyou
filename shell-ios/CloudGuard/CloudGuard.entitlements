<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 微信 Universal Links 关联域名（对齐 manifest.json applinks:fuyou.yefiot.com）
         需在 Apple 开发者后台为 Profile 开启 Associated Domains，并在
         https://fuyou.yefiot.com/.well-known/apple-app-site-association 配置 AASA -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:fuyou.yefiot.com</string>
    </array>
</dict>
</plist>
