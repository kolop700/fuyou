				"navigationBarTitleText": "扫码开门"
			}
		},
		{
			"path": "pages/camera/index",
			"style": {
				"navigationBarTitleText": "摄像头"
			}
		},
		{
			"path": "pages/lq-upgrade/upgrade",
			"style": {
				"navigationBarTitleText": "",
				"navigationStyle": "custom",
				"app-plus": {
					"bounce": "none",
					"animationType": "none", //取消窗口动画
					"background": "transparent" // 设置背景透明
				}
			}
		},
		{
			"path": "workbench_package/pages/about/index",
			"style": {
				"navigationBarTitleText": "关于我们"
			}
		}
	],
	"subPackages": [
		{
			"root": "user_package",
			"pages": [
				{
					"path": "pages/login/index",
					"style": {
						"navigationStyle": "custom"
					}
				},
				{
					"path": "pages/webview",
					"style": {
						"navigationBarTitleText": "网页全屏预览",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "pages/profile/index",
