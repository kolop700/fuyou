            "bounce": "none" 
        }
	},
	"tabBar": {
		"custom": true,
		"color": "#64748b",
		"selectedColor": "#667eea",
		"backgroundColor": "#ffffff",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/home-active.png"
			},
			{
				"pagePath": "pages/door/index",
				"text": "开门",
				"iconPath": "static/tabbar/door.png",
				"selectedIconPath": "static/tabbar/door-active.png"
			},
			{
				"pagePath": "pages/workbench/index",
				"text": "工作台",
				"iconPath": "static/tabbar/device.png",
				"selectedIconPath": "static/tabbar/device-active.png"
			},
			{
				"pagePath": "pages/my/index",
				"text": "我的",
				"iconPath": "static/tabbar/my.png",
				"selectedIconPath": "static/tabbar/my-active.png"
			}
		]
	},
	"uniIdRouter": {
		"loginPage": "user_package/pages/login/index",
		"needLogin": [
			"workbench_package/pages/.*"
		]
	}
