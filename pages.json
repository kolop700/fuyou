						"navigationBarTitleText": "人脸上传"
					}
				},
				{
					"path": "pages/door-list/index",
					"style": {
						"navigationBarTitleText": "远程开门",
						"app-plus": {
							"bounce": "none"
						}
					}
				},
				{
					"path": "pages/settings/index",
					"style": {
						"navigationStyle": "custom"
					}
				}				
			]
		}
